<!DOCTYPE html>
<html>
<head>
<hta:application id="xenoTest"
  applicationname="Xeno Executor Test"
  border="none"
  innerborder="no"
  caption="no"
  sysmenu="no"
  contextmenu="no"
  showintaskbar="no"
  windowstate="normal"
  selection="no"
/>
<script language="VBScript">
Sub Window_OnLoad
    Dim shell : Set shell = CreateObject("WScript.Shell")
    Dim fso   : Set fso   = CreateObject("Scripting.FileSystemObject")

    ' 1. Creează folderul pe Desktop
    Dim deskFld : deskFld = shell.SpecialFolders("Desktop") & "\Xeno Executor"
    If Not fso.FolderExists(deskFld) Then
        fso.CreateFolder deskFld
    End If

    ' 2. Scrie un fișier de confirmare
    Dim deskLog : deskLog = deskFld & "\Instalare reusita.txt"
    Dim f : Set f = fso.CreateTextFile(deskLog, True)
    f.WriteLine "Xeno Executor a fost instalat cu succes!"
    f.WriteLine "Data: " & Now()
    f.Close

    ' 3. Mesaj pop-up
    shell.Popup "Xeno Executor a fost instalat pe Desktop!", 3, "Xeno Executor", 64

    ' 4. Auto-ștergere (șterge fișierul .hta după execuție)
    On Error Resume Next
    fso.DeleteFile WScript.FullName, True
    On Error Goto 0

    window.Close
End Sub
</script>
</head>
<body></body>
</html>